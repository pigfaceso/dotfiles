#!/bin/sh

pathtoname() {
    udevadm info -p /sys/"$1" | awk -v FS== '/DEVNAME/ {print $2}'
}

stdbuf -oL -- udevadm monitor --udev -s block | while read -r -- _ _ event devpath _; do
        if [ "$event" = add ]; then
            devname=$(pathtoname "$devpath")
            MOUNT_PATH=$(udisksctl mount --block-device "$devname" --no-user-interaction | awk '/Mounted/ {print $4}')

            if [ -n "${MOUNT_PATH}" ]; then
              echo $MOUNT_PATH
              notify-send -a udisk-automount "Mount $devname" "Mounted to ${MOUNT_PATH}"
            fi
        fi
done
