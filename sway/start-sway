#!/bin/sh --login

## General exports
export XDG_CURRENT_DESKTOP=sway
export XDG_SESSION_DESKTOP=sway
export XDG_SESSION_TYPE=wayland

## user environment
if [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/sway/environment" ]; then
    set -o allexport
    source "${XDG_CONFIG_HOME:-$HOME/.config}/sway/environment"
    set +o allexport
fi

exec /usr/bin/sway
